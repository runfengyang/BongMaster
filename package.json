{
  "name": "bongmaster-vue",
  "version": "5.2.0",
  "description": "BongMaster - 项目管理桌面应用 with MCP Server support (Electron + Vue 3)",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -P \"npm run dev:vite\" \"wait-on http://localhost:5173 && npm run dev:electron\" --",
    "dev:vite": "vite",
    "dev:electron": "NODE_ENV=development electron .",
    "dev:mcp": "NODE_ENV=development electron . --mcp-server",
    "build": "npm run build:vite && npm run build:electron",
    "build:vite": "vite build",
    "build:electron": "electron-builder",
    "preview": "vite preview"
  },
  "keywords": [
    "electron",
    "vue",
    "project-management",
    "sqlite"
  ],
  "author": "Ason's BongBong",
  "license": "ISC",
  "dependencies": {
    "@hackernoon/pixel-icon-library": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@popperjs/core": "^2.11.8",
    "archiver": "^7.0.1",
    "axios": "^1.15.2",
    "better-sqlite3": "^12.9.0",
    "bootstrap": "^5.3.8",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.11",
    "extract-zip": "^2.0.1",
    "katex": "^0.17.0",
    "marked": "^18.0.5",
    "pinia": "^3.0.4",
    "quill": "^2.0.3",
    "tyme4ts": "^1.5.5",
    "uuid": "^14.0.0",
    "vue": "^3.5.33",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@vitejs/plugin-vue": "^6.0.6",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "ical.js": "^2.2.1",
    "vite": "^8.0.10",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.bongmaster.app",
    "productName": "BongMaster",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/renderer/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    }
  }
}
